generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  passwordHash           String
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  currentPeriodEnd       DateTime?
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business            Business?
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  name              String
  industry          String
  phone             String?
  email             String?
  address           String?
  city              String?
  slug              String   @unique
  googleBusinessUrl String?
  stripeCustomerId  String?
  plan              String   @default("free")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customers    Customer[]
  campaigns    Campaign[]
  profile      PublicProfile?
  calls        Call[]
  reviews      Review[]
  agentLogs    AgentLog[]
  referrals    Referral[]
  jobs         Job[]
  invoices     Invoice[]
  teamMembers  TeamMember[]
  availability Availability?
  timeOffs     TimeOff[]
}

model Customer {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String?
  lastServiceDate DateTime?
  totalSpend      Float     @default(0)
  serviceCount    Int       @default(0)
  status          String    @default("active")
  notes           String?
  lastFollowupAt  DateTime?
  referralCode    String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaignResults CampaignResult[]
  referrals       Referral[]
  jobs            Job[]
}

model Campaign {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type            String    @default("winback")
  status          String    @default("draft")
  targetSegment   String    @default("at-risk")
  messageTemplate String?
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  results CampaignResult[]
}

model CampaignResult {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     String    @default("sent")
  revenue    Float     @default(0)
  sentAt     DateTime  @default(now())
  repliedAt  DateTime?
}

model PublicProfile {
  id          String   @id @default(cuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  headline    String?
  description String?
  services    String?
  reviewCount Int      @default(0)
  avgRating   Float    @default(0)
  bookingUrl  String?
  isPublished Boolean  @default(true)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Call {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callerPhone      String
  status           String   @default("answered") // answered | missed | voicemail | transferred
  intent           String?  // appointment | emergency | inquiry | complaint
  transcript       String?
  appointmentBooked Boolean @default(false)
  createdAt        DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform    String   @default("google") // google | yelp | facebook
  rating      Int
  content     String?
  authorName  String?
  aiReply     String?
  isReplied   Boolean  @default(false)
  reviewDate  DateTime
  createdAt   DateTime @default(now())
}

model AgentLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent      String   // intake | followup | reputation | winback | referral
  action     String
  detail     String?
  customerId String?
  createdAt  DateTime @default(now())
}

model Referral {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code        String   @unique
  clicks      Int      @default(0)
  conversions Int      @default(0)
  rewarded    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Job {
  id            String    @id @default(cuid())
  jobNumber     String    @unique
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  serviceType   String
  status        String    @default("requested")
  priority      String    @default("normal")
  scheduledAt   DateTime?
  completedAt   DateTime?
  address       String?
  lineItems     Json?
  subtotal      Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  notes         String?
  internalNotes String?
  photos        String[]
  assignedTo    String?
  stripePaymentIntentId  String?
  stripeCustomerId       String?
  stripePaymentMethodId  String?
  captureStatus String?
  source        String    @default("manual")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoice       Invoice?
}

model Invoice {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId        String
  invoiceNumber     String   @unique
  status            String   @default("draft")
  lineItems         Json
  subtotal          Float
  tax               Float
  total             Float
  stripePaymentLink String?
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime @default(now())
}

model TeamMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  role       String   @default("technician")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Availability {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workingDays  Json
  startTime    String   @default("08:00")
  endTime      String   @default("18:00")
  slotDuration Int      @default(120)
  bufferTime   Int      @default(30)
  timezone     String   @default("America/Toronto")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime
  allDay     Boolean  @default(true)
  startTime  String?
  endTime    String?
  reason     String?
  createdAt  DateTime @default(now())
}
