# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/starloop

# ─── NextAuth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ─── Claude API ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Twilio (SMS) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ─── Google OAuth & My Business API ───────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: Google My Business API, Google Business Profile API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ─── Resend (Email) ───────────────────────────────────────────────
RESEND_API_KEY=

# ─── Cron Security ────────────────────────────────────────────────
CRON_SECRET=starloop-cron-2024

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StarLoop
